{
  "name": "nanjil-mep-backend",
  "version": "1.0.0",
  "description": "Nanjil MEP Service – Local Electrical & Plumbing Booking Backend",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "start:prod": "NODE_ENV=production node dist/src/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/scripts/migrate-production.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate:existing-upi": "tsx scripts/migrate-existing-upi.ts",
    "db:migrate:existing-upi:prod": "node dist/scripts/migrate-existing-upi.js",
    "secret:jwt": "tsx scripts/generate-jwt-secret.ts",
    "smoke:auth": "tsx scripts/smoke-auth-flow.ts",
    "setup:initial": "tsx scripts/initial-setup.ts",
    "setup:initial:prod": "node dist/scripts/initial-setup.js",
    "audit:admin-login": "tsx scripts/audit-admin-login.ts",
    "audit:notifications": "tsx scripts/audit-notification-config.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:admin:prod": "node dist/scripts/seed-admin.js",
    "sync:production-admins": "tsx scripts/sync-production-admins.ts",
    "seed:technicians": "tsx scripts/seed-technicians.ts",
    "backup": "bash scripts/backup-db.sh",
    "test": "node --import ./tests/setup-env.mjs --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.13",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.31",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "9.0.3",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}
